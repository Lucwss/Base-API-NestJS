{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "moduleDirectories": ["node_modules", "."],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(@faker-js/faker|uuid)/)"]
}
